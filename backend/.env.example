# SentimentAI Backend Production Environment Configuration
# Host & Port (Hosting providers like Render/Railway/Heroku inject PORT automatically)
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Configured Frontend Origin(s) for CORS.
# Accepts a single URL or comma-separated list of URLs.
# Localhost origins (http://localhost:5173, http://127.0.0.1:5173, etc.) are always permitted.
FRONTEND_URL=https://sentimentai.vercel.app

# Optional custom artifact paths (defaults to reliable internal backend/models paths)
# MODEL_PATH=backend/models/sentiment_model.joblib
# VECTORIZER_PATH=backend/models/tfidf_vectorizer.joblib
# METRICS_PATH=backend/models/evaluation_metrics.json
